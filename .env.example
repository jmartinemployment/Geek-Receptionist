# --- Required ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth token: used ONLY to verify that incoming webhooks are really from Twilio
TWILIO_AUTH_TOKEN=your-auth-token
# Standard API key (Console > Account > API keys & tokens): used for every call to Twilio
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret
# The Twilio number callers reach and texts come from (E.164)
TWILIO_NUMBER=+15615550199
# Owner's cell: rung in Dial mode, notified of every missed call (E.164)
OWNER_CELL=+15615550100
# Name used in the text and the screening prompt
COMPANY_NAME=Geek @ Your Spot
# Public https URL of this service, no trailing slash (must match what Twilio calls)
PUBLIC_BASE_URL=https://geek-receptionist-production.up.railway.app

# --- Optional (defaults shown) ---
# Dial = ring OWNER_CELL first; Forwarded = client's line forwards unanswered calls here
CALL_MODE=Dial
# Seconds to ring the owner before the call counts as missed
RING_SECONDS=18
# Owner must press a key to accept, so their own voicemail can't hide a missed call
SCREEN_CALLS=true
# Text sent to missed callers; {company} is replaced with COMPANY_NAME
# CALLER_TEXT=Hi, this is {company}. Sorry we missed your call...
# Don't text the same caller again within this many minutes
REPEAT_TEXT_MINUTES=10
# Only set false for local testing without Twilio
VALIDATE_TWILIO_SIGNATURE=true
